#version 460

layout(set = 0, binding = 0, rgba16f) uniform image2D output_image;

layout(local_size_x = 8, local_size_y = 8) in;

void main() {
	if (all(lessThan(gl_GlobalInvocationID.xy, imageSize(output_image)))) {
		imageStore(output_image, ivec2(gl_GlobalInvocationID.xy), vec4((gl_GlobalInvocationID.xy + 0.5) / imageSize(output_image), 0, 0));
	}
}
